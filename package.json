{
  "name": "windows-coding-agent",
  "version": "0.1.12",
  "description": "Security-bounded Windows MCP coding controller for explicitly authorized Git repositories.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File Windows-Coding-Agent.ps1",
    "server": "node src/index.js",
    "setup": "node src/setup.js",
    "doctor": "node src/doctor.js",
    "test": "node scripts/ensure-stage-compat.js && node --test",
    "validate": "node src/validate.js",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "update": "powershell -NoProfile -ExecutionPolicy Bypass -File Update.ps1",
    "deps": "powershell -NoProfile -ExecutionPolicy Bypass -File Install-Dependencies.ps1",
    "manage": "node src/startup.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.1.0"
  },
  "license": "GPL-3.0-only"
}
